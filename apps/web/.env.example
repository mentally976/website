# Supabase → Project Settings → API. Both values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public origin used in auth emails (http://localhost:3000 locally, your Vercel URL in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin dashboard (/admin). Server-only: never add a NEXT_PUBLIC_ prefix to these.
# Comma-separated emails allowed into /admin. Put the real address only in .env.local and Vercel, never here
# (this file is committed). Unset means nobody can open /admin.
ADMIN_EMAILS=you@example.com

# Supabase → Project Settings → API Keys → Secret key. Used only to list users for the admin.
SUPABASE_SECRET_KEY=sb_secret_xxx
